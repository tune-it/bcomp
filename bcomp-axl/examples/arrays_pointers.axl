int data[5];
int total;
int last;

void main() {
    int i;
    int *p;
    for (i = 0; i < 5; i = i + 1) {
        data[i] = (i + 1) * 10;
    }
    total = 0;
    p = &data[0];
    for (i = 0; i < 5; i = i + 1) {
        total = total + *p;
        p = p + 1;
    }
    last = data[4];
    halt();
}
